{
  "name": "beer-distributor-pro",
  "version": "2.1.2",
  "description": "Beer distributor management system PRO+",
  "main": "server.js",
  "jest": {
    "testEnvironment": "node",
    "maxWorkers": 1,
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "globalTeardown": "<rootDir>/tests/globalTeardown.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backups/",
      "/\\.backup/"
    ],
    "collectCoverageFrom": [
      "routes/**/*.js",
      "src/services/**/*.js",
      "middleware/**/*.js"
    ],
    "testTimeout": 30000
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "echo 'No build step required'",
    "build:vendor": "node scripts/build-vendor.js",
    "bump:version": "node scripts/bump-version.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.3.1"
  },
  "lint-staged": {
    "*.{js,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
