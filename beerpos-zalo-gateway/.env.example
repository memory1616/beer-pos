NODE_ENV=production
PORT=3100
# Chi bind loopback - gateway khong mo ra internet.
# Neu can truy cap tu mayy khac qua nginx, doi thanh 127.0.0.1 (keo theo nginx).
HOST=127.0.0.1
TZ=Asia/Ho_Chi_Minh

# Database rieng cua Gateway - TUYET DOI KHONG dung chung voi BeerPOS
DATABASE_PATH=./data/gateway.sqlite

# API key - KHONG hardcode, KHONG commit key that
ADMIN_API_KEY=replace_with_secure_key
INTEGRATION_API_KEY=replace_with_secure_key

# Provider: mock | authorized
# - mock: KHONG gui tin that, chi mo phong (dung an toan khi moi trien khai)
# - authorized: provider Zalo that
MESSAGE_PROVIDER=mock

# Worker
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL=2000
WORKER_MAX_ATTEMPTS=4
WORKER_LEASE_MS=60000
WORKER_BATCH_SIZE=10

# Backoff (ms) - lan 1, 2, 3, 4
RETRY_DELAYS_MS=10000,30000,120000,300000

# Gioi han
MAX_MESSAGE_LENGTH=2000

# Rate limit
RATE_LIMIT_SEND=300
RATE_LIMIT_ADMIN=600

# CORS - chi danh sach domain duoc phep
CORS_ORIGINS=http://localhost:3100
