# =============================================================================
# BeerPOS Environment Variables - PRODUCTION (VPS Cloud Server)
# =============================================================================
#
# ĐÂY LÀ FILE MẪU — chỉ chứa giá trị KHÔNG nhạy cảm.
# File `.env` thật nằm trên server `/var/www/beer-pos/.env` (KHÔNG commit).
#
# Lưu ý quan trọng (sửa 2026-11-13):
#   Server production đã từng bị copy nhầm file .env từ môi trường LOCAL
#   → ADMIN_DOMAIN=localhost, PUBLIC_DOMAIN=localhost, IS_CLOUD_SERVER=false,
#     CLOUD_DOMAIN=http://localhost:3000.
#   Hậu quả: /api/discover trả về "http://localhost:3000" → client đồng bộ
#   tưởng đang kết nối chính nó; mất cơ chế ghi nhận thiết bị đã báo.
#
#   → Sao chép file này lên server, KHÔNG dùng .env từ máy local.
#   → Sau khi sửa .env trên server: `pm2 restart ecosystem.config.js --update-env`
#
# =============================================================================

# Server - Production VPS
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Auth
# KHÔNG commit mật khẩu thật. Sinh secret mới: bash scripts/gen-secrets.sh
# rồi điền vào .env trên server (KHÔNG điền vào file này).
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_THIS_ON_THE_SERVER

# Session secret — BẮT BUỘC (>= 32 ký tự random). Thiếu → app từ chối start
# ở chế độ production (kiểm tra tại ecosystem.config.js).
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_32_CHARS

# Branding — tên hiển thị trên landing page & báo cáo gửi qua Zalo
DISTRIBUTOR_NAME=Bia Tươi Tây Ninh

# Domain Configuration — phải KHỚP với DNS + nginx trên server
ADMIN_DOMAIN=admin.biatuoitayninh.store
PUBLIC_DOMAIN=biatuoitayninh.store
DRIVER_DOMAIN=giaohang.biatuoitayninh.store

# =============================================================================
# CLOUD MODE - CRITICAL FOR SYNC
# =============================================================================
# These settings make this server act as a central data hub
# All other devices will sync with this server
#
# IS_CLOUD_SERVER=true → bật ghi nhận thiết bị vào bảng `sync_meta`
#                        (key: device_last_seen_<deviceId>)
# CLOUD_DOMAIN        → URL mà client dùng để kết nối tới cloud server
#                        PHẢI là URL public thật (không phải localhost).
IS_CLOUD_SERVER=true
CLOUD_MODE=true
CLOUD_DOMAIN=https://admin.biatuoitayninh.store

# =============================================================================
# JWT Secret - CHANGE THIS IN PRODUCTION
# =============================================================================
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_32_CHARS

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET=

# OpenAI API Key
OPENAI_API_KEY=

# =============================================================================
# Database (SQLite - leave as is)
# =============================================================================
# This file contains ALL data - make sure to backup regularly!
# DB_PATH=./database.sqlite

# =============================================================================
# APP VERSION - Increment after each deployment to force cache refresh
# =============================================================================
APP_VERSION=2026041501
