# Normalize line endings — tránh script shell bị lỗi CRLF khi chạy trên Linux
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.conf text eol=lf
*.txt text eol=lf

# Giữ nguyên CRLF cho script Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.sqlite binary
*.sqlite.gz binary
*.mp4 binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
